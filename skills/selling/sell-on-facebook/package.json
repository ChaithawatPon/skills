{
  "name": "sell-on-facebook",
  "version": "1.1.0",
  "private": true,
  "description": "Public-safe Marketplace seller workflow with preview-bound publish and non-destructive one-listing maintenance gates",
  "type": "module",
  "main": "scripts/facebook_marketplace_autopilot.mjs",
  "scripts": {
    "verify:no-api": "node scripts/verify_no_api.mjs",
    "autopilot": "node scripts/facebook_marketplace_autopilot.mjs",
    "draft": "node scripts/facebook_marketplace_draft.mjs",
    "publish": "node scripts/facebook_marketplace_publish.mjs",
    "inbox": "node scripts/facebook_marketplace_inbox.mjs --scan",
    "inbox:auto": "node scripts/facebook_marketplace_inbox.mjs --auto",
    "inbox:self-test": "node scripts/facebook_marketplace_inbox.mjs --self-test",
    "inventory": "node scripts/facebook_marketplace_inventory.mjs --scan",
    "inventory:self-test": "node scripts/facebook_marketplace_inventory.mjs --self-test",
    "maintenance": "node scripts/facebook_marketplace_maintenance.mjs",
    "maintenance:self-test": "node scripts/facebook_marketplace_maintenance.mjs --self-test",
    "autopilot:self-test": "node scripts/facebook_marketplace_autopilot.mjs --self-test",
    "draft:self-test": "node scripts/facebook_marketplace_draft.mjs --self-test",
    "publish:self-test": "node scripts/facebook_marketplace_publish.mjs --self-test",
    "sort:prepare": "node scripts/sort_images.mjs prepare",
    "sort:apply": "node scripts/sort_images.mjs apply",
    "sort:self-test": "node scripts/sort_images.mjs --self-test",
    "overlay": "node scripts/overlay_card.mjs",
    "overlay:self-test": "node scripts/overlay_card.mjs --self-test",
    "groups:plan": "node scripts/group_cross_post.mjs plan",
    "groups:self-test": "node scripts/group_cross_post.mjs --self-test",
    "self-test": "node scripts/facebook_marketplace_draft.mjs --self-test && node scripts/facebook_marketplace_publish.mjs --self-test && node scripts/facebook_marketplace_inbox.mjs --self-test && node scripts/facebook_marketplace_inventory.mjs --self-test && node scripts/facebook_marketplace_maintenance.mjs --self-test && node scripts/facebook_marketplace_autopilot.mjs --self-test && npm run sort:self-test && npm run overlay:self-test && npm run groups:self-test",
    "test": "npm run verify:no-api && node --test tests/*.mjs"
  },
  "keywords": [
    "facebook",
    "marketplace",
    "listings",
    "seller-tools",
    "items",
    "sell",
    "browser automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChaithawatPon/sell-to-facebook-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/ChaithawatPon/sell-to-facebook-marketplace/issues"
  },
  "homepage": "https://github.com/ChaithawatPon/sell-to-facebook-marketplace#readme",
  "files": [
    "SKILL.md",
    "agents",
    "lib",
    "references",
    "scripts",
    "tests",
    "package.json",
    "package-lock.json",
    ".gitignore"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {},
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
